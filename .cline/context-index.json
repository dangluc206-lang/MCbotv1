{
  "schemaVersion": 1,
  "sourceTreeSha": "540ff7d770e4bb0ae9e879aec4f613b796291dc2",
  "usage": "Use this file first. It maps task type to the smallest useful context set.",
  "alwaysRead": [
    ".clinerules/00-core.md",
    ".clinerules/01-verification.md"
  ],
  "conditionalRules": {
    "serverTasks": ".clinerules/02-server.md",
    "craftingTasks": ".clinerules/03-crafting.md"
  },
  "taskMap": {
    "bug": {
      "start": [
        ".cline/routing.json",
        ".cline/ownership.json"
      ],
      "then": [
        "direct caller/callee",
        "targeted test",
        "relevant config"
      ]
    },
    "crafting": {
      "read": [
        ".cline/crafting-contract.json",
        ".cline/routing.json#crafting",
        ".cline/server-profile.json"
      ]
    },
    "removeB5Center": {
      "read": [
        ".cline/crafting-contract.json",
        ".cline/routing.json#crafting",
        ".cline/routing.json#craftingB5Compatibility",
        ".cline/architecture.json",
        ".cline/ownership.json"
      ],
      "goal": "Move generic crafting authority away from B5-specific classes without changing verified server mechanics."
    },
    "serverGUI": {
      "read": [
        ".cline/server-profile.json",
        ".cline/routing.json#gui",
        ".cline/routing.json#storage"
      ]
    },
    "reconnect": {
      "read": [
        ".cline/architecture.json",
        ".cline/ownership.json",
        ".cline/routing.json#connectionReconnect"
      ]
    },
    "desktop": {
      "read": [
        ".cline/routing.json#desktop",
        ".cline/architecture.json"
      ]
    },
    "mode": {
      "read": [
        ".cline/architecture.json",
        ".cline/routing.json#modePlatform"
      ]
    },
    "configuration": {
      "read": [
        ".cline/routing.json#configuration",
        ".cline/architecture.json"
      ]
    }
  },
  "skillRouting": {
  "systematic-debugging": {
    "trigger": [
      "bug",
      "runtime error",
      "test failure",
      "build failure",
      "unexpected behavior",
      "regression",
      "performance regression",
      "race condition",
      "reconnect failure",
      "GUI/inventory/crafting failure"
    ],
    "beforeEdit": true,
    "skill": ".cline/skills/systematic-debugging/SKILL.md"
  },

  "verification-before-completion": {
    "trigger": [
      "claiming complete",
      "claiming fixed",
      "claiming tests pass",
      "commit",
      "PR",
      "task closure",
      "release"
    ],
    "beforeClaim": true,
    "skill": ".cline/skills/verification-before-completion/SKILL.md"
  },

  "code-review": {
    "trigger": [
      "review branch",
      "review PR",
      "review changes",
      "review since commit",
      "review WIP",
      "before merge"
    ],
    "afterImplementation": true,
    "skill": ".cline/skills/code-review/SKILL.md"
  },

  "doubt-review": {
    "trigger": [
      "non-trivial decision",
      "architecture decision",
      "uncertain server behavior",
      "uncertain GUI semantics",
      "inventory uncertainty",
      "reconnect uncertainty",
      "legacy removal",
      "irreversible migration",
      "high blast radius"
    ],
    "beforeStandingDecision": true,
    "skill": ".cline/skills/doubt-review/SKILL.md"
  },

  "change-spec": {
    "trigger": [
      "cross-cutting change",
      "architecture migration",
      "multi-module refactor",
      "B5 decoupling/removal",
      "new subsystem",
      "change spanning ownership boundaries",
      "contract migration"
    ],
    "beforeImplementation": true,
    "skill": ".cline/skills/change-spec/SKILL.md"
  }
},

"routingOrder": [
  "doubt-review",
  "change-spec",
  "systematic-debugging",
  "code-review",
  "verification-before-completion"
],
  "neverStartByReadingEverything": true
}