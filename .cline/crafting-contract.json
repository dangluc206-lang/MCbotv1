      ]
    }
  },
  "currentExecutionFlow": [
    "capture BEFORE inventory state",
    "open /ks",
    "identify minerals GUI",
    "resolve crafting entry",
    "enter crafting menu",
    "resolve recipe slot from logical recipe id",
    "open quantity GUI",
    "resolve live quantity action",
    "click quantity once",
    "close quantity GUI if still open",
    "verify output/input evidence",
    "reconcile before retrying uncertain mutations"
  ],
  "quantityPolicy": {
    "serverCapability": [
      1,
      64,
      "ALL"
    ],
    "workflowDecidesSafety": true,
    "doNotAssumeAllSafe": true,
    "doNotUseFixedSlotAsLogicalIdentity": true
  },
  "verificationRules": [
    "click success is not craft success",
    "craft() success is not completion",
    "expected output must be observed",
    "relevant state must settle",
    "generation must remain valid",
    "uncertain mutation requires reconciliation before repeat"
  ],
