NODE_ENV=development
LOG_LEVEL=info

# Optional per-bot secrets. Bot profiles remain non-secret JSON.
MCBOT_BOT_01_PASSWORD=
MCBOT_BOT_02_PASSWORD=

# Discord GUI inspection. Never commit the real token.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to control Minecraft bots.
DISCORD_ALLOWED_USER_IDS=
# Optional. If omitted, MCbot finds/creates channels using names from config/discord/discord.json.
DISCORD_CONTROL_CHANNEL_ID=
DISCORD_CONFIG_CHANNEL_ID=
DISCORD_ERRORS_CHANNEL_ID=
# Logging overrides (optional)
# LOG_CONSOLE_LEVEL=info
# LOG_FORMAT=compact
# LOG_META=summary
# LOG_FILE_ENABLED=true
# LOG_FILE_LEVEL=debug
# LOG_FILE_DIR=data/logs
