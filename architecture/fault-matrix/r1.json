      "artifact": "runtime failure plus replay trace",
      "cleanupAssertion": "identical click is not replayed",
      "evidenceTest": "tests/unit/simulation/FaultMatrixContract.test.js"
    },
    {
      "id": "gui-stale-window",
      "faultClass": "GUI",
