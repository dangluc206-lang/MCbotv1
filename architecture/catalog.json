{
  "schemaVersion": 3,
  "officialDocuments": [
    ".better-web-ui.md"
  ],
  "governedDocumentRoots": [
  ],
  "documentScanExclusions": [
    ".cline",
    ".clinerules",
    ".agents"
  ],
  "runtimeEntrypoints": [
    "src/index.js",
    "src/desktop/main.js",
    "src/desktop/preload.js",
    "src/desktop/renderer/core/RendererApiClient.js",
    "src/desktop/renderer/core/Html.js",
    "src/desktop/renderer/core/RendererRouter.js",
    "src/desktop/renderer/core/DevRouter.js",
    "src/desktop/renderer/core/KeyedDom.js",
    "src/desktop/renderer/core/RendererSnapshotLoop.js",
    "src/desktop/renderer/core/RendererStore.js",
    "src/desktop/renderer/components/AccessibleDialog.js",
    "src/desktop/renderer/pages/PageCatalog.js",
    "src/desktop/renderer/pages/ConfigGroupCatalog.js",
    "src/desktop/renderer/features/b5/B5ViewModel.js",
    "src/desktop/renderer/features/b5/B5JourneyPresenter.js",
    "src/desktop/renderer/features/crafting/CraftingRequestPanel.js",
    "src/desktop/renderer/features/b5/B5CraftRequestPanel.js",
    "src/desktop/renderer/features/incidents/IncidentViewModel.js",
    "src/desktop/renderer/features/incidents/IncidentPresenter.js",
    "src/desktop/renderer/features/builder/TypedModuleEditor.js",
    "src/desktop/renderer/features/modes/ModeViewModel.js",
    "src/desktop/renderer/features/connection/ConnectionViewModel.js",
    "src/desktop/renderer/features/operator/OperatorPresenter.js",
    "src/desktop/renderer/features/bots/BotCardPresenter.js",
    "src/desktop/renderer/features/dev/DevPages.js",
    "src/desktop/renderer/core/RendererEventBindings.js",
    "src/desktop/renderer/app.js"
  ],
  "configuration": {
    "specModule": "src/configuration/ConfigSpecs.js",
    "botProfileDirectory": "config/bots",
    "customModeDirectory": "config/modes/custom"
  },
  "eventScopes": {
    "registryModule": "src/core/events/EventScopeRegistry.js"
  },
  "scopeOwners": {
    "application": [
      "configuration",
      "logging",
      "bot-registry",
      "discord",
      "fleet-scheduling"
    ],
    "bot": [
      "runtime-state",
      "mode-coordination",
      "connection",
      "operations",
      "gui",
      "movement",
      "inventory",
      "server-features"
    ],
    "connection": [
      "raw-client-listeners",
      "packet-observation",
      "generation-owned-waiters"
    ],
    "operation": [
      "cancellation",
      "timeouts",
      "locks",
      "cleanup",
      "side-effect-evidence"
    ]
  },
  "exclusiveSideEffects": [
    {
      "id": "server-command",
      "pattern": "\\.chat\\s*\\(",
      "owners": [
        "src/commands/CommandExecutor.js"
      ]
    },
    {
      "id": "gui-click",
      "pattern": "\\.clickWindow\\s*\\(",
      "owners": [
        "src/gui/click/ClickExecutor.js"
      ]
    },
    {
      "id": "client-end",
      "pattern": "\\.end\\s*\\(",
      "owners": [
        "src/connection/ConnectionManager.js"
      ]
    },
    {
      "id": "fishing-raw-protocol",
      "pattern": "\\._client\\b",
      "owners": [
        "src/modes/fishing/ConnectionPacketObserver.js"
      ]
    }
  ],
  "compatibilityBoundaries": {
    "craftingB5Compat": {
      "owner": "crafting",
      "aliasFiles": [
        "src/server-features/crafting/B5AutomationService.js",
        "src/server-features/crafting/b5/trace/B5TraceRecorder.js",
        "src/server-features/crafting/b5/support/B5StageContract.js",
        "src/desktop/use-cases/B5CraftRequestUseCases.js"
      ],
      "activeB5Implementation": [
        "src/server-features/crafting/B5PlanningService.js",
        "src/server-features/crafting/B5AutomationRuntimeDecorator.js",
        "src/server-features/crafting/b5/B5B1InventoryCoordinator.js",
        "src/server-features/crafting/b5/B5CycleCoordinator.js",
        "src/server-features/crafting/b5/B5FinalCraftCoordinator.js",
        "src/server-features/crafting/b5/B5IntermediateCoordinator.js",
        "src/server-features/crafting/b5/B5ReserveChainCoordinator.js",
        "src/server-features/crafting/b5/flows/B5ReadFlow.js",
        "src/server-features/crafting/b5/flows/B5PlanningFlow.js",
        "src/server-features/crafting/b5/flows/B5StorageFlow.js",
        "src/server-features/crafting/b5/flows/B5WithdrawFlow.js",
        "src/server-features/crafting/b5/flows/B5CraftFlow.js",
        "src/server-features/crafting/b5/flows/B5KhoReadFlow.js",
        "src/server-features/crafting/b5/flows/B2InputAcquisitionFlow.js",
        "src/server-features/crafting/b5/support/B5ActionDiagnostics.js",
        "src/server-features/crafting/b5/support/B5InventoryState.js",
        "src/server-features/crafting/b5/support/B5ProgressTracker.js",
        "src/server-features/crafting/b5/support/B5RecipeResolver.js"
      ]
    }
  },
  "boundaries": [
    {
      "id": "generic-crafting-authority",
      "files": [
        "src/server-features/crafting/CraftPlanningService.js",
        "src/server-features/crafting/CraftReadService.js",
        "src/server-features/crafting/CraftAutomationService.js",
        "src/server-features/crafting/CraftTraceRecorder.js",
        "src/server-features/crafting/CraftingService.js",
        "src/server-features/crafting/CraftingOperation.js",
        "src/server-features/crafting/CraftingResultVerifier.js",
        "src/server-features/crafting/CraftingVerificationCoordinator.js",
        "src/server-features/crafting/CraftingVerificationService.js",
        "src/server-features/crafting/CraftingOutcomeClassifier.js",
        "src/server-features/crafting/verification/StageExecutionContract.js"
      ],
      "allowedPatterns": [
        "require\\(['\"]\\.\\/B5AutomationService['\"]\\)",
        "require\\(['\"]\\.\\/b5\\/trace\\/B5TraceRecorder['\"]\\)"
      ],
      "forbiddenPatterns": [
        "B5PlanningService",
        "B5Planner",
        "B5ExecutionPlanner",
        "b5/support/B5StageContract",
        "crafting/b5/B5",
        "crafting/b5/flows/B5",
        "crafting/b5/support/B5",
        "planning/crafting/B5"
      ]
    },
    {
      "id": "fishing-mode-no-raw-client",
      "files": [
        "src/modes/fishing/FishingModeService.js"
      ],
      "forbiddenPatterns": [
        "BotContext",
        "\\._client\\b",
        "\\.clickWindow\\s*\\(",
        "\\.chat\\s*\\(",
        "\\.fish\\s*\\(",
        "\\.end\\s*\\(",
        "\\bVec3\\b"
      ]
    },
    {
      "id": "collector-mode-no-raw-client",
      "files": [
        "src/modes/collector-b5/CollectorB5ModeService.js"
      ],
      "forbiddenPatterns": [
        "\\._client\\b",
        "\\.clickWindow\\s*\\(",
        "\\.chat\\s*\\(",
        "\\.end\\s*\\(",
        "\\bVec3\\b"
      ]
    },
    {
      "id": "planner-purity",
      "globs": [
        "src/planning/**/*.js"
      ],
      "forbiddenPatterns": [
        "\\.clickWindow\\s*\\(",
        "\\.chat\\s*\\(",
        "\\.end\\s*\\(",
        "setTimeout\\s*\\(",
        "setInterval\\s*\\("
      ]
    }
  ],
  "pendingWiringSources": [
    {
      "file": "src/desktop/use-cases/B5CraftRequestUseCases.js",
      "owner": "crafting",
      "reason": "Deprecated IPC compat alias for mcbot:b5:craft-*; required only by compat tests while the renderer migration lands. Uses a lazy require so it never forms a runtime import cycle with the generic use-case."
    },
    {
      "file": "src/server-features/crafting/B5AutomationService.js",
      "owner": "crafting",
      "reason": "Compat alias re-exporting CraftAutomationService; kept requireable while collector-B5 and crafting parity tests migrate to the generic import path."
    },
    {
      "file": "src/server-features/crafting/b5/trace/B5TraceRecorder.js",
      "owner": "crafting",
      "reason": "Compat alias re-exporting CraftTraceRecorder; kept requireable while B5 trace/replay parity tests migrate to the generic import path."
    },
    {
      "file": "src/server-features/crafting/b1-b3/B1B3CraftingModule.js",
      "owner": "crafting",
      "reason": "B1-B3 stage module extracted by the generic crafting refactor; the composition root still wires the B5 coordinators, and only tests/unit/overlay/B1B3Boundary.test.js consumes this module today."
    },
    {
      "file": "src/server-features/crafting/b1-b3/B1B3InputCoordinator.js",
      "owner": "crafting",
      "reason": "Input acquisition slice of the unwired B1-B3 module; it reuses verification/StageExecutionContract and no runtime or script entrypoint requires it yet."
    },
    {
      "file": "src/server-features/crafting/b1-b3/B1B3ReadService.js",
      "owner": "crafting",
      "reason": "Read slice of the unwired B1-B3 module; the runtime currently reads inventory/pv2/kho through the inventory, personal-vault and storage capabilities directly."
    },
    {
      "file": "src/server-features/crafting/b1-b3/B1B3ReserveCoordinator.js",
      "owner": "crafting",
      "reason": "Reserve loop of the unwired B1-B3 module; B5 reserve handling still runs through server-features/crafting/b5/B5ReserveChainCoordinator.js."
    },
    {
      "file": "src/server-features/crafting/b5/flows/B5DepositFlow.js",
      "owner": "crafting",
      "reason": "Thin personal-vault deposit adapter kept for the pending generic craft wiring; nothing requires it at runtime or from scripts."
    },
    {
      "file": "src/server-features/crafting/b5/flows/B5InventoryReadFlow.js",
      "owner": "crafting",
      "reason": "Thin inventory read adapter kept for the pending generic craft wiring; the runtime reads inventory through src/items/inventory/InventoryReader.js."
    },
    {
      "file": "src/server-features/crafting/b5/flows/B5Pv2ReadFlow.js",
      "owner": "crafting",
      "reason": "Thin personal-vault read adapter kept for the pending generic craft wiring; the runtime reads /pv 2 through the personal-vault capability."
    },
    {
      "file": "src/server-features/crafting/b5/support/B5StageContract.js",
      "owner": "crafting",
      "reason": "Compat alias re-exporting verification/StageExecutionContract; no test requires the B5 path anymore, kept only until the alias file is removed."
    },
    {
      "file": "src/planning/crafting/B5Planner.js",
      "owner": "crafting",
      "reason": "Legacy B5-only planning shim kept as compat boundary for B5PlanningService/tests; generic code must use CraftingPlanner+CraftPlanningService directly and no runtime or script entrypoint requires it yet."
    }
  ],
  "staleManifest": "scripts/cleanup-stale.js",
  "coverage": {
    "include": "src/**/*.js",
    "lines": 80,
    "branches": 65,
    "functions": 80
  },
  "architectureBaseline": {
    "manifest": "architecture/baseline/current.json",
    "schema": "architecture/baseline/schema.json",
    "inspector": "scripts/inspect-architecture-baseline.js"
  },
  "artifactOwnershipManifest": "architecture/artifact-ownership.json"
}
