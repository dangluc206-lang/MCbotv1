{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcbot://architecture/baseline/schema-v1",
  "title": "MCbot Architecture Baseline",
  "type": "object",
  "required": [
    "schemaVersion",
    "baselineVersion",
    "workPackage",
    "generatedAt",
    "releaseVersion",
    "scope",
    "revision",
    "counts",
    "sourceAreas",
    "reachability",
    "sideEffects",
    "events",
    "modes",
    "capabilities",
    "modePlatform",
    "serverSpecificFacts",
    "configuration",
    "dynamicConfiguration",
    "architectureInspection",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "baselineVersion": {
      "type": "integer",
      "minimum": 1
    },
    "workPackage": {
      "const": "WP-001"
    },
    "generatedAt": {
      "type": "string"
    },
    "releaseVersion": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "revision": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "sourceAreas": {
      "type": "array",
      "minItems": 1
    },
    "reachability": {
      "type": "object"
    },
    "sideEffects": {
      "type": "array"
    },
    "events": {
      "type": "object"
    },
    "modes": {
      "type": "array"
    },
    "capabilities": {
      "type": "object"
    },
    "serverSpecificFacts": {
      "type": "array"
    },
    "configuration": {
      "type": "array"
    },
    "architectureInspection": {
      "type": "object"
    },
    "findings": {
      "type": "array"
    },
    "dynamicConfiguration": {
      "type": "array"
    },
    "modePlatform": {
      "type": "object"
    }
  }
}
