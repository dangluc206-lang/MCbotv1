{
  "name": "mcbot-complete",
  "version": "2.7.67",
  "private": true,
  "description": "MCbot Desktop - multi-bot Minecraft automation control application and Mineflayer runtime",
  "main": "src/desktop/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=80 tests/**/*.test.js",
    "validate": "npm run validate:structure && npm run validate:architecture",
    "validate:structure": "node scripts/validate-structure.js",
    "validate:architecture": "node scripts/validate-architecture.js",
    "baseline:inspect": "node scripts/inspect-architecture-baseline.js",
    "baseline:report": "node scripts/inspect-architecture-baseline.js --report",
    "baseline:update": "node scripts/inspect-architecture-baseline.js --write",
    "baseline:check": "node scripts/inspect-architecture-baseline.js --check",
    "inspect:config": "node scripts/validate-config.js",
    "inspect:architecture": "node scripts/validate-architecture.js --json",
    "replay": "node scripts/replay-scenario.js tests/fixtures/replay/stale-side-effects.json",
    "cleanup:stale:dry": "node scripts/cleanup-stale.js",
    "cleanup:stale": "node scripts/cleanup-stale.js --apply",
    "core:start": "node src/index.js",
    "desktop:start": "electron .",
    "desktop:make:win": "node scripts/build-windows.js",
    "desktop:build:win": "node scripts/build-windows.js",
    "mode:scaffold": "node scripts/scaffold-mode.js",
    "update:package": "node scripts/create-local-update-package.js",
    "replay:b5": "node scripts/replay-b5-plan.js tests/fixtures/replay/b5-planner-basic.json",
    "test:installed": "node scripts/run-tests.js --installed",
    "audit:ownership": "node scripts/audit-side-effect-ownership.js",
    "profile:minerua:inspect": "node scripts/inspect-minerua-knowledge.js",
    "profile:minerua:check": "node scripts/inspect-minerua-knowledge.js --check",
    "support:bundle": "node scripts/build-support-bundle.js",
    "replay:fault": "node scripts/replay-scenario.js tests/fixtures/replay/click-response-lost.json",
    "quality:fast": "node scripts/run-quality-gates.js --lane fast",
    "quality:release": "node scripts/run-quality-gates.js --lane release",
    "artifact:integrity": "node scripts/release-artifact-integrity.js",
    "artifact:verify": "node scripts/verify-release-zip.js",
    "scale:measure": "node --expose-gc scripts/measure-scale-baseline.js",
    "scale:check": "node --expose-gc scripts/measure-scale-baseline.js --check",
    "scale:baseline:check": "node scripts/measure-scale-baseline.js --validate-file architecture/scale/current.json",
    "check:error-vocabulary": "node scripts/check-error-vocabulary.js",
    "check:slo": "node scripts/check-slo-contract.js",
    "test:e2e:desktop": "node --test tests/e2e/desktop/desktop-critical-flow.test.js",
    "support:validate": "node scripts/validate-support-bundle.js --self-check",
    "support:validate:file": "node scripts/validate-support-bundle.js",
    "check:product-docs": "node scripts/check-product-docs.js",
    "check:static": "node scripts/check-static-quality.js",
    "check:critical-coverage": "node scripts/check-critical-coverage.js",
    "check:version": "node scripts/check-version-contract.js",
    "perf:operator": "node scripts/measure-operator-performance.js --check",
    "perf:live:check": "node scripts/measure-live-workload.js",
    "test:fault-matrix:r1": "node --test tests/unit/simulation/R1RecoveryFaultMatrix.test.js tests/unit/simulation/FaultMatrixContract.test.js tests/unit/gui/Gui.test.js tests/unit/modes/ModeFaultPolicy.test.js tests/unit/recovery/FleetControlService.test.js tests/unit/desktop/DesktopSecretStore.test.js tests/unit/desktop/DesktopFatalRecovery.test.js tests/unit/diagnostics/TraceSupportBundle.test.js",
    "test:fault-matrix:r5": "node --test tests/unit/simulation/R5FaultMatrixContract.test.js tests/unit/simulation/FaultMatrixContract.test.js tests/unit/modes/B5CraftModeService.test.js tests/unit/desktop/RuntimeConfigMigrator.test.js tests/unit/recovery/FleetControlService.test.js tests/unit/desktop/DesktopApiContract.test.js tests/unit/desktop/ReleaseCanaryPolicy.test.js",
    "check:release-canary": "node scripts/check-release-canary-policy.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "discord.js": "^14.25.1",
    "extract-zip": "2.0.1",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "electron": "43.4.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "electron-winstaller": "5.4.4",
    "prettier": "3.9.6"
  },
  "productName": "MCbot Desktop",
  "author": "MCbot"
}
