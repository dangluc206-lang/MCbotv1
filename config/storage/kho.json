{
  "commandKey": "storage",
  "resourceAmountPatterns": [
    "(?:dang\\s*co|so\\s*luong|amount)\\s*[:：]?\\s*(?<value>[\\d.,]+)"
  ],
  "allowStackCountFallback": false,
  "capacityIndicator": {
    "itemId": "storage_capacity",
    "scanAllSlots": true,
    "usedPatterns": [
      "(?:da\\s*su\\s*dung|used)\\s*[:：]?\\s*(?<value>[\\d.,]+)"
    ],
    "freePatterns": [
      "(?:dang\\s*trong|con\\s*trong|free)\\s*[:：]?\\s*(?<value>[\\d.,]+)"
    ],
    "limitPatterns": [
      "(?:dung\\s*luong|suc\\s*chua|capacity|limit)\\s*[:：]?\\s*(?<value>[\\d.,]+)"
    ],
    "regex": "(?<used>[\\d.,]+)\\s*[/|]\\s*(?<limit>[\\d.,]+)",
    "slot": 49,
    "fallbackLimit": 800000
  },
  "sell": {
    "enabled": true,
    "commandKey": "storageSell",
    "mode": "gui",
    "resultDelayMs": 250,
    "itemAliases": {
      "cobblestone": "COBBLESTONE",
      "coal": "COAL",
      "redstone": "REDSTONE",
      "lapis_lazuli": "LAPIS_LAZULI",
      "iron_ingot": "IRON_INGOT",
      "gold_ingot": "GOLD_INGOT",
      "diamond": "DIAMOND",
      "emerald": "EMERALD",
      "coal_block": "COAL_BLOCK",
      "redstone_block": "REDSTONE_BLOCK",
      "lapis_block": "LAPIS_BLOCK",
      "iron_block": "IRON_BLOCK",
      "gold_block": "GOLD_BLOCK",
      "diamond_block": "DIAMOND_BLOCK",
      "emerald_block": "EMERALD_BLOCK"
    },
    "allowAll": false,
    "openSettleMs": 300,
    "closeSettleMs": 180,
    "updateTimeoutMs": 1500,
    "openAfterCloseSettleMs": 1000,
    "blockOnly": true,
    "reserveCoverage": 1.5,
    "allowSingle": false
  },
  "withdraw": {
    "enabled": true,
    "numericQuantities": [
      1,
      8,
      16,
      64,
      128,
      256,
      512
    ],
    "withdrawPatterns": [
      "(?:^|\\s)(?:rut|withdraw)(?:\\s|$)"
    ],
    "stackPatterns": [
      "(?:1\\s*(?:stack|stacks)|mot\\s*stack)"
    ],
    "fullInventoryPatterns": [
      "(?:day\\s*(?:tui|inventory)|full\\s*inventory)"
    ],
    "detailTimeoutMs": 5000,
    "verifyAttempts": 12,
    "verifyRetryMs": 100,
    "unchangedConfirmationReads": 2,
    "minimumOutputSlots": 2,
    "allowStack": true,
    "allowFillInventory": true,
    "reuseQuantityGui": true,
    "maxWithdrawalActions": 64,
    "maxBatchClicks": 16
  },
  "guiId": "storage",
  "guiTimeoutMs": 5000,
  "openSettleMs": 300,
  "refreshSettleMs": 100,
  "openAttempts": 3,
  "retryDelayMs": 600,
  "retryCloseSettleMs": 400,
  "openAfterCloseSettleMs": 1000,
  "closeConfirmTimeoutMs": 1000
}
